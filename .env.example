# Supabase — Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...votre_cle_anon
# Clé secrète (seed, scripts) — PAS la clé anon / publishable
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Stripe (paiement inscription / abonnement)
# -----------------------------------------------------------------------------
# Mode test — clés héritées du dépôt GitLab meetme-backend (application.properties).
# À copier dans .env.local uniquement — ne pas committer sk_test en clair.
# Dashboard Stripe : https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# -----------------------------------------------------------------------------
# Email — option A : Resend (utilisé par l'app Next.js actuellement)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Meet & Match <notifications@meetmatch@gmail.com>

# -----------------------------------------------------------------------------
# Email — option B : SMTP Novalitix (ancienne stack Java meetme-backend)
# -----------------------------------------------------------------------------
# Non branché dans le code Next.js pour l'instant — référence migration / secours.
# Hôte : mail.novalitix.com | Port : 587 | STARTTLS
# SMTP_HOST=mail.novalitix.com
# SMTP_PORT=587
# SMTP_USER=noreply@novalitix.com
# SMTP_PASSWORD=
# SMTP_FROM=Meet & Match <noreply@novalitix.com>

# -----------------------------------------------------------------------------
# PayPal sandbox (ancienne stack — non intégré dans Meet&Match)
# -----------------------------------------------------------------------------
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_MODE=sandbox

# -----------------------------------------------------------------------------
# Notifications push navigateur
# -----------------------------------------------------------------------------
# Générer avec : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:contact@meetmatch@gmail.com

# Secret partagé webhook Supabase → /api/webhooks/notifications
NOTIFICATION_WEBHOOK_SECRET=
# Secret Vercel Cron → /api/cron/notification-delivery
CRON_SECRET=

# Géocodage OpenStreetMap (optionnel — User-Agent requis par Nominatim)
GEOCODE_USER_AGENT=MeetAndMatch/1.0 (contact@meetmatch@gmail.com)

# -----------------------------------------------------------------------------
# Ancienne infra (référence migration — ne pas utiliser en prod Meet&Match)
# -----------------------------------------------------------------------------
# API Java legacy : https://meetme.novalitix.com
# MySQL legacy (commenté dans meetme-backend) : 217.76.48.68:3317/meetme_db_2

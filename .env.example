# Supabase — Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...votre_cle_anon
# Clé secrète (seed, scripts) — PAS la clé anon / publishable
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Phase test gratuite : true | omettre ou false = tarifs réels + checkout
# NEXT_PUBLIC_PRICING_TEST_MODE=true

# Offre de lancement : inscription + matching gratuits jusqu'à cette date (YYYY-MM-DD, fin UTC)
# NEXT_PUBLIC_LAUNCH_FREE_UNTIL=2026-08-10

# =============================================================================
# PAIEMENTS — checklist credentials
# =============================================================================
# Providers absents = masqués dans l'UI. Stripe reste le défaut s'il est seul.
# Après avoir rempli les clés : les coller aussi sur Vercel + redeploy.
#
# --- Stripe (masqué par défaut) ---
# Stripe refuse les services de rencontre (ToS). PayPal + ViaziPay sont les
# moyens principaux. Pour réafficher Stripe dans l'UI :
#   NEXT_PUBLIC_ENABLE_STRIPE=true
# 1. Dashboard : https://dashboard.stripe.com/apikeys
# 2. Webhook : POST {NEXT_PUBLIC_APP_URL}/api/webhooks/stripe
#    Events : checkout.session.completed,
#             checkout.session.async_payment_succeeded,
#             checkout.session.async_payment_failed
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_ENABLE_STRIPE=true
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# En local / sandbox : sk_test_... / pk_test_...

# --- PayPal Checkout (Orders API v2) ---
# 1. Compte https://developer.paypal.com → Apps & Credentials
# 2. App → Client ID + Secret (sandbox puis live)
# 3. PAYPAL_MODE=sandbox | live
# 4. Webhook PayPal → https://meet-and-match.vercel.app/api/webhooks/paypal
#    Events : CHECKOUT.ORDER.APPROVED, PAYMENT.CAPTURE.COMPLETED
# 5. Copier l'ID du webhook dans PAYPAL_WEBHOOK_ID (vérif. signature)
# -----------------------------------------------------------------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# --- ViaziPay (MTN MoMo + Orange Money, Cameroun) ---
# 1. Compte marchand https://viazipay.com (+ KYC)
# 2. Public Key + Private Key (profil marchand)
# 3. Activer OM et MOMO dans le dashboard ViaziPay
# 4. VIAZIPAY_MODE=DEV | PROD
# 5. Notify URL : https://meet-and-match.vercel.app/api/webhooks/viazipay
# 6. Taux USD→XAF (ViaziPay facture en XAF) — défaut 600 ; plancher pratique 100 XAF
# -----------------------------------------------------------------------------
VIAZIPAY_PUBLIC_KEY=
VIAZIPAY_PRIVATE_KEY=
VIAZIPAY_MODE=DEV
VIAZIPAY_USD_TO_XAF=600

# -----------------------------------------------------------------------------
# Email — option A : Resend (utilisé par l'app Next.js actuellement)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Meet & Match <notifications@meetmatch@gmail.com>

# -----------------------------------------------------------------------------
# Email — option B : SMTP Novalitix (ancienne stack Java meetme-backend)
# -----------------------------------------------------------------------------
# Non branché dans le code Next.js pour l'instant — référence migration / secours.
# Hôte : mail.novalitix.com | Port : 587 | STARTTLS
# SMTP_HOST=mail.novalitix.com
# SMTP_PORT=587
# SMTP_USER=noreply@novalitix.com
# SMTP_PASSWORD=
# SMTP_FROM=Meet & Match <noreply@novalitix.com>

# -----------------------------------------------------------------------------
# Notifications push navigateur
# -----------------------------------------------------------------------------
# Générer avec : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:contact@meetmatch@gmail.com

# Secret partagé webhook Supabase → /api/webhooks/notifications
NOTIFICATION_WEBHOOK_SECRET=
# Secret Vercel Cron → /api/cron/notification-delivery
CRON_SECRET=

# Géocodage OpenStreetMap (optionnel — User-Agent requis par Nominatim)
GEOCODE_USER_AGENT=MeetAndMatch/1.0 (contact@meetmatch@gmail.com)

# -----------------------------------------------------------------------------
# Ancienne infra (référence migration — ne pas utiliser en prod Meet&Match)
# -----------------------------------------------------------------------------
# API Java legacy : https://meetme.novalitix.com
# MySQL legacy (commenté dans meetme-backend) : 217.76.48.68:3317/meetme_db_2
